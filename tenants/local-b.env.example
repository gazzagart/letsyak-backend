# Local tenant B example.
# Use from a second copy of this directory, or with an explicit Compose project:
#   set -a; . ./tenants/local-b.env.example; set +a; ./setup.sh --local

TENANT_STACK_NAME=letsyak-local-b
MATRIX_DOMAIN=local-b.letsyak.test
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_PUBLIC_HOST=localhost

SYNAPSE_HTTP_PORT=8108
WELL_KNOWN_HTTP_PORT=8180
CONTROL_PLANE_HTTP_PORT=8185
VAULT_API_HTTP_PORT=8190
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

CONTROL_PLANE_TENANT_CONFIG=./control-plane/config/tenants.local-multi.sample.json
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Local-only placeholders for direct `docker compose --env-file ... config` checks.
# `./setup.sh --local` generates real secrets into `.env`.
VAULT_API_DOMAIN=localhost:8190
VAULT_FILES_DOMAIN=localhost:9100
POSTGRES_PASSWORD=local-b-postgres-change-me
MINIO_ACCESS_KEY=localbminioaccesskey
MINIO_SECRET_KEY=local-b-minio-secret-change-me