# Local tenant A example.
# Use from a fresh/copy working directory with:
#   set -a; . ./tenants/local-a.env.example; set +a; ./setup.sh --local

TENANT_STACK_NAME=letsyak-local-a
MATRIX_DOMAIN=local-a.letsyak.test
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_PUBLIC_HOST=localhost

SYNAPSE_HTTP_PORT=8008
WELL_KNOWN_HTTP_PORT=8080
CONTROL_PLANE_HTTP_PORT=8085
VAULT_API_HTTP_PORT=8090
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

CONTROL_PLANE_TENANT_CONFIG=./control-plane/config/tenants.local-multi.sample.json
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Local-only placeholders for direct `docker compose --env-file ... config` checks.
# `./setup.sh --local` generates real secrets into `.env`.
VAULT_API_DOMAIN=localhost:8090
VAULT_FILES_DOMAIN=localhost:9000
POSTGRES_PASSWORD=local-a-postgres-change-me
MINIO_ACCESS_KEY=localaminioaccesskey
MINIO_SECRET_KEY=local-a-minio-secret-change-me