# docker-compose.override.yml.example
# ─────────────────────────────────────────────────────────────────────────────
# Template for local development.
# Run  ./setup.sh --local  to auto-generate this as docker-compose.override.yml,
# OR copy this file:  cp docker-compose.override.yml.example docker-compose.override.yml
#
# DO NOT commit docker-compose.override.yml  (it is in .gitignore).
#
# Connecting the Flutter app to this backend:
#
#   Platform               Homeserver URL to enter in app
#   ─────────────────────  ───────────────────────────────────────────────────
#   Flutter web (browser)  http://${LOCAL_PUBLIC_HOST:-localhost}:${SYNAPSE_HTTP_PORT:-8008}
#   iOS Simulator          http://${LOCAL_PUBLIC_HOST:-localhost}:${SYNAPSE_HTTP_PORT:-8008}
#   Android Emulator       http://10.0.2.2:${SYNAPSE_HTTP_PORT:-8008}
#   Physical device        http://<YOUR_MACHINE_LAN_IP>:${SYNAPSE_HTTP_PORT:-8008}
#                           (run: ipconfig getifaddr en0 to find your LAN IP)
#                           Requires changing LOCAL_BIND_ADDRESS to 0.0.0.0.
# ─────────────────────────────────────────────────────────────────────────────

services:
  # Expose Synapse directly on localhost — no reverse proxy needed locally.
  synapse:
    ports:
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${SYNAPSE_HTTP_PORT:-8008}:8008"

  # Expose well-known on a different port to avoid conflicts
  well-known:
    ports:
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${WELL_KNOWN_HTTP_PORT:-8080}:80"

  # Expose Vault API and override public URLs to use plain http://localhost
  vault-api:
    ports:
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${VAULT_API_HTTP_PORT:-8090}:8090"
    environment:
      MINIO_PUBLIC_URL: "http://${LOCAL_PUBLIC_HOST:-localhost}:${MINIO_API_PORT:-9000}"
      VAULT_PUBLIC_URL: "http://${LOCAL_PUBLIC_HOST:-localhost}:${VAULT_API_HTTP_PORT:-8090}"
      CORS_ALLOWED_ORIGINS: "${LOCAL_CORS_ALLOWED_ORIGINS:-http://localhost:*,http://127.0.0.1:*}"

  # Expose workspace discovery for Flutter web/mobile local testing.
  control-plane:
    ports:
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${CONTROL_PLANE_HTTP_PORT:-8085}:8085"

  # Expose MinIO API and console
  minio:
    ports:
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${MINIO_API_PORT:-9000}:9000"
      - "${LOCAL_BIND_ADDRESS:-127.0.0.1}:${MINIO_CONSOLE_PORT:-9001}:9001"
    command: server /data --console-address ":9001"
    environment:
      # Allow browser uploads from any localhost origin (local dev only)
      MINIO_API_CORS_ALLOW_ORIGIN: "${LOCAL_CORS_ALLOWED_ORIGINS:-http://localhost:*,http://127.0.0.1:*}"

  # TURN/STUN, push notifications, and the web container are not needed locally.
  # Flutter runs the app directly; push notifications require real device tokens.
  coturn:
    profiles: ["disabled"]

  sygnal:
    profiles: ["disabled"]

  letsyak-web:
    profiles: ["disabled"]

networks:
  # Replace the external proxy-network with a local bridge.
  # This lets Docker Compose start without Nginx Proxy Manager installed.
  proxy-network:
    external: false
    name: ${TENANT_STACK_NAME:-letsyak}-proxy-local
